#!/usr/bin/env bash
# Generate the joins (apps/<app>/clusters/<cluster>/) from the facets each app has.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<EOF
Usage: scripts/generate [--check] [cluster...]

Writes apps/<app>/clusters/<cluster>/{kustomization.yaml,argocd.json} for every app with
a facet matching the cluster (apps/<app>/facets/<key>/<value>[-<environment>]/ for its
environment, role, topology, region or platform fact, or apps/<app>/facets/cluster/<cluster>/), and
deletes generated joins for apps no longer selected.
Default: all clusters, which also deletes generated joins for clusters that no longer exist.

  --check   generate into a temp copy and diff against the working tree; exit 1 on
            any difference. Never modifies the tree.
EOF
}

check=false
clusters=()
for arg in "$@"; do
  case $arg in
    -h|--help) usage; exit 0 ;;
    --check) check=true ;;
    -*) die "unknown option: $arg" ;;
    *) clusters+=("$arg") ;;
  esac
done

require_tools yq
ROOT=$(repo_root)

if $check; then
  tmp=$(mktemp -d)
  cleanup_add "$tmp"
  tar -C "$ROOT" --exclude=./.git --exclude=./rendered -cf - . | tar -C "$tmp" -xf -
  # The copy isn't a git repo, so its scripts resolve the root from their own location.
  "$tmp/scripts/generate" "${clusters[@]+"${clusters[@]}"}" >/dev/null || die "generate failed"
  changes=$(diff -ruN "$ROOT/apps" "$tmp/apps" | sed -e "s|$ROOT/|a/|g" -e "s|$tmp/|b/|g" || true)
  if [[ -n $changes ]]; then
    echo "$changes"
    die "generated files are out of date; run scripts/generate"
  fi
  echo "generated files are up to date"
  exit 0
fi

all_clusters=false
if [[ ${#clusters[@]} -eq 0 ]]; then
  all_clusters=true
  mapfile -t clusters < <(list_clusters)
fi
for c in "${clusters[@]}"; do
  [[ -d $ROOT/clusters/$c ]] || die "unknown cluster: $c (no clusters/$c/)"
done

work=$(mktemp -d)
cleanup_add "$work"

mapfile -t all_apps < <(list_apps)

# Pass 1: resolve and validate everything before touching the tree.
# $work/<cluster>.apps: selected apps; $work/<cluster>.<app>.facets: its facets, in order.
for c in "${clusters[@]}"; do
  : >"$work/$c.apps"
  for app in "${all_apps[@]}"; do
    app_facets "$app" "$c" >"$work/$c.$app.facets"
    [[ -s $work/$c.$app.facets ]] || continue
    echo "$app" >>"$work/$c.apps"
    [[ -d $ROOT/apps/$app/base ]] || die "$c: app '$app': apps/$app/base/ does not exist"
    mapfile -t facets <"$work/$c.$app.facets"
    for f in "${facets[@]}"; do
      [[ -f $ROOT/apps/$app/facets/$f/kustomization.yaml ]] \
        || die "$c: app '$app': apps/$app/facets/$f/ has no kustomization.yaml"
    done
    pc=$ROOT/apps/$app/facets/$PER_CLUSTER_FACET
    [[ ! -d $pc || -f $pc/kustomization.yaml ]] \
      || die "$c: app '$app': apps/$app/facets/$PER_CLUSTER_FACET/ has no kustomization.yaml"
    sync=$(resolve_sync "$app")
    SYNC=$sync yq -e -n 'env(SYNC) | [
        (.automated.enabled | tag) == "!!bool",
        (.automated.prune | tag) == "!!bool",
        (.automated.selfHeal | tag) == "!!bool",
        .wave != null] | all' >/dev/null 2>&1 \
      || die "$c: app '$app': resolved sync needs boolean automated.{enabled,prune,selfHeal} and a 'wave', got $sync"
    echo "$sync" >"$work/$c.$app.sync.json"
  done
  mapfile -t apps <"$work/$c.apps"
  # Stale joins must carry the generated header before we delete them.
  for dir in "$ROOT"/apps/*/clusters/"$c"/; do
    [[ -d $dir ]] || continue
    app=$(basename "$(dirname "$(dirname "$dir")")")
    if ! printf '%s\n' "${apps[@]+"${apps[@]}"}" | grep -qxF "$app"; then
      head -n1 "$dir/kustomization.yaml" 2>/dev/null | grep -qF "$GENERATED_PREFIX" \
        || die "apps/$app/clusters/$c/ is no longer assigned to $c and is not a generated join; remove it by hand"
    fi
  done
done

# Joins for clusters that no longer exist (only when generating every cluster).
orphans=()
if $all_clusters; then
  for dir in "$ROOT"/apps/*/clusters/*/; do
    [[ -d $dir ]] || continue
    c=$(basename "$dir")
    [[ -d $ROOT/clusters/$c ]] && continue
    app=$(basename "$(dirname "$(dirname "$dir")")")
    head -n1 "$dir/kustomization.yaml" 2>/dev/null | grep -qF "$GENERATED_PREFIX" \
      || die "apps/$app/clusters/$c/ is for a cluster that doesn't exist and is not a generated join; remove it by hand"
    orphans+=("$dir")
  done
fi

# Pass 2: write.
for dir in "${orphans[@]+"${orphans[@]}"}"; do
  app=$(basename "$(dirname "$(dirname "$dir")")")
  rm -rf -- "$dir"
  rmdir "$ROOT/apps/$app/clusters" 2>/dev/null || true
  echo "removed apps/$app/clusters/$(basename "$dir") (cluster no longer exists)"
done
for c in "${clusters[@]}"; do
  mapfile -t apps <"$work/$c.apps"
  for dir in "$ROOT"/apps/*/clusters/"$c"/; do
    [[ -d $dir ]] || continue
    app=$(basename "$(dirname "$(dirname "$dir")")")
    if ! printf '%s\n' "${apps[@]+"${apps[@]}"}" | grep -qxF "$app"; then
      rm -rf -- "$dir"
      rmdir "$ROOT/apps/$app/clusters" 2>/dev/null || true
      echo "removed apps/$app/clusters/$c"
    fi
  done
  for app in "${apps[@]}"; do
    out=$ROOT/apps/$app/clusters/$c
    mkdir -p "$out"
    mapfile -t facets <"$work/$c.$app.facets"
    join_kustomization "$app" "$c" "${facets[@]}" >"$out/kustomization.yaml"
    join_argocd_json "$app" "$c" "$(cat "$work/$c.$app.sync.json")" "${facets[@]}" >"$out/argocd.json"
    echo "wrote apps/$app/clusters/$c"
  done
done
