#!/usr/bin/env bash
# Show which apps run on each cluster, with their facets and sync settings.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/whatruns [cluster...]

Prints APP FACETS AUTO-SYNC PRUNE SELF-HEAL WAVE per cluster (default: all clusters), headed
by its environment, role, topology, region and platform, sorted by wave then app. Reads the
cluster's overlays (their facets) and the apps' argocd.yaml at the commit the cluster's
cluster-config ApplicationSet is pinned to; clusters tracking main are read from the working
tree. Clusters whose base includes tenant-config also list their tenants at that
ApplicationSet's pin.
USAGE
}

clusters=()
for arg in "$@"; do
  case $arg in
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $arg" ;;
    *) clusters+=("$arg") ;;
  esac
done

require_tools kustomize yq
ROOT=$(repo_root)
if [[ ${#clusters[@]} -eq 0 ]]; then
  mapfile -t clusters < <(list_clusters)
fi

# at_rev <rev> <path>: a file's content at <rev>, or in the working tree for main.
at_rev() {
  if [[ $1 == main ]]; then cat "$ROOT/$2"; else git -C "$ROOT" show "$1:$2"; fi
}

# overlay_apps <rev> <cluster>: apps with an overlay for the cluster at <rev> (working tree for main).
overlay_apps() {
  if [[ $1 == main ]]; then
    for d in "$ROOT"/apps/*/clusters/"$2"/; do
      if [[ -d $d ]]; then basename "$(dirname "$(dirname "$d")")"; fi
    done
  else
    git -C "$ROOT" ls-tree -d -r --name-only "$1" -- apps | sed -nE "s|^apps/([^/]+)/clusters/$2\$|\1|p"
  fi
}

first=true
for c in "${clusters[@]}"; do
  [[ -d $ROOT/clusters/$c ]] || die "unknown cluster: $c"
  $first || echo
  first=false
  rev=$(appset_revision "$c" cluster-config)
  kind=$(for k in "${FACET_KEYS[@]}"; do cluster_fact "$c" "$k"; done | paste -sd' ' -)
  if [[ $rev == main ]]; then
    echo "$c  [$kind]  (cluster-config @ main; showing working tree)"
  else
    git -C "$ROOT" cat-file -e "$rev^{commit}" 2>/dev/null || die "$c: pinned commit $rev not found locally; fetch it"
    echo "$c  [$kind]  (cluster-config @ ${rev:0:12})"
  fi
  {
    printf 'APP\tFACETS\tAUTO-SYNC\tPRUNE\tSELF-HEAL\tWAVE\n'
    for app in $(overlay_apps "$rev" "$c"); do
      facets=$(at_rev "$rev" "apps/$app/clusters/$c/kustomization.yaml" \
        | sed -n "s|^- \.\./\.\./facets/||p" | grep -vxF "$PER_CLUSTER_FACET" | paste -sd, -)
      at_rev "$rev" "apps/$app/argocd.yaml" | sync_with_defaults \
        | APP=$app FACETS=$facets yq -p=json -o=yaml -r \
            '[strenv(APP), strenv(FACETS), .automated.enabled, .automated.prune, .automated.selfHeal, .wave] | @tsv'
    done | LC_ALL=C sort -t$'\t' -k6,6n -k1,1
  } | awk -F'\t' '
      { for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } n = NR; nf = NF }
      END { for (r = 1; r <= n; r++) { line = "  "; for (i = 1; i <= nf; i++) line = line sprintf(i < nf ? "%-" w[i] + 2 "s" : "%s", cell[r, i]); print line } }'
  if cluster_appsets "$c" | grep -qxF tenant-config; then
    trev=$(appset_revision "$c" tenant-config)
    if [[ $trev == main ]]; then
      tenants=$(for d in "$ROOT"/tenants/*/clusters/"$c"/; do
        if [[ -d $d ]]; then basename "$(dirname "$(dirname "$d")")"; fi
      done)
      label="main; working tree"
    else
      git -C "$ROOT" cat-file -e "$trev^{commit}" 2>/dev/null || die "$c: pinned commit $trev not found locally; fetch it"
      tenants=$(git -C "$ROOT" ls-tree -d -r --name-only "$trev" -- tenants | sed -nE "s|^tenants/([^/]+)/clusters/$c\$|\1|p")
      label=${trev:0:12}
    fi
    tenants=$(echo $tenants | sed 's/ /, /g')
    echo "  tenants (tenant-config @ $label): ${tenants:-none}"
  fi
done
