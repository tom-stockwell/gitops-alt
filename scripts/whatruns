#!/usr/bin/env bash
# Show which apps run on each cluster, with overlay, mixins and sync settings.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/whatruns [cluster...]

Prints APP OVERLAY MIXINS AUTO-SYNC PRUNE SELF-HEAL WAVE per cluster (default: all clusters),
sorted by wave then app. Reads the generated argocd.json files at the commit the cluster's
cluster-config ApplicationSet is pinned to; clusters tracking main are read from the
working tree.
USAGE
}

clusters=()
for arg in "$@"; do
  case $arg in
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $arg" ;;
    *) clusters+=("$arg") ;;
  esac
done

require_tools yq
ROOT=$(repo_root)
if [[ ${#clusters[@]} -eq 0 ]]; then
  mapfile -t clusters < <(list_clusters)
fi

first=true
for c in "${clusters[@]}"; do
  [[ -d $ROOT/clusters/$c ]] || die "unknown cluster: $c"
  $first || echo
  first=false
  rev=$(appset_revision "$c" cluster-config)
  if [[ $rev == main ]]; then
    echo "$c  (cluster-config @ main; showing working tree)"
  else
    git -C "$ROOT" cat-file -e "$rev^{commit}" 2>/dev/null || die "$c: pinned commit $rev not found locally; fetch it"
    echo "$c  (cluster-config @ ${rev:0:12})"
  fi
  {
    printf 'APP\tOVERLAY\tMIXINS\tAUTO-SYNC\tPRUNE\tSELF-HEAL\tWAVE\n'
    if [[ $rev == main ]]; then
      for f in "$ROOT"/apps/*/clusters/"$c"/argocd.json; do
        [[ -f $f ]] && cat "$f"
      done
    else
      git -C "$ROOT" ls-tree -r --name-only "$rev" -- apps | grep -E "^apps/[^/]+/clusters/$c/argocd.json\$" \
        | while read -r f; do git -C "$ROOT" show "$rev:$f"; done
    fi | while IFS= read -r json; do
      yq -p=json -o=yaml -r '[.app, .overlay, (.mixins | join(",")), .sync.automated.enabled, .sync.automated.prune, .sync.automated.selfHeal, .sync.wave] | @tsv' <<<"$json" \
        | awk -F'\t' -v OFS='\t' '$3 == "" { $3 = "-" } 1'
    done | LC_ALL=C sort -t$'\t' -k7,7n -k1,1
  } | awk -F'\t' '
      { for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } n = NR; nf = NF }
      END { for (r = 1; r <= n; r++) { line = "  "; for (i = 1; i <= nf; i++) line = line sprintf(i < nf ? "%-" w[i] + 2 "s" : "%s", cell[r, i]); print line } }'
done
