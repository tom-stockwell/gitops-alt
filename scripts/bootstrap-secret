#!/usr/bin/env bash
# Print the local cluster Secret that tells the ApplicationSet which cluster it is on.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/bootstrap-secret <name> [--wave N]

Prints the in-cluster Argo CD cluster Secret for clusters/<name> (default wave 1).
Apply with: scripts/bootstrap-secret <name> --wave N | oc apply -f -
USAGE
}

name="" wave=1
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --wave) [[ $# -ge 2 ]] || die "--wave needs a value"; wave=$2; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z $name ]] || die "unexpected argument: $1"; name=$1; shift ;;
  esac
done
[[ -n $name ]] || { usage >&2; exit 1; }
[[ $wave =~ ^[0-9]+$ ]] || die "--wave must be a non-negative integer"

ROOT=$(repo_root)
[[ -d $ROOT/clusters/$name ]] || die "unknown cluster: $name (no clusters/$name/)"

cat <<SECRET
apiVersion: v1
kind: Secret
metadata:
  name: in-cluster
  namespace: openshift-gitops
  labels:
    argocd.argoproj.io/secret-type: cluster
    gitops.example.com/local: "true"
    wave: "$wave"
stringData:
  name: $name
  server: https://kubernetes.default.svc
SECRET
