#!/usr/bin/env bash
# Check the structural rules of the repo.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/lint

Checks joins, cluster dirs and app dirs against the repo rules and lists every
violation. Exits 1 if there are any.
USAGE
}

case ${1:-} in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) die "unexpected argument: $1" ;;
esac

require_tools kustomize yq
ROOT=$(repo_root)
cd "$ROOT"

errors=()
warnings=()
err() { errors+=("$*"); }

mapfile -t clusters < <(list_clusters)

# Joins.
for k in apps/*/clusters/*/kustomization.yaml; do
  [[ -f $k ]] || continue
  dir=$(dirname "$k")
  c=$(basename "$dir")
  head -n1 "$k" | grep -qF "$GENERATED_PREFIX" || err "$k: missing GENERATED header"
  extra=$(yq -r 'keys | .[] | select(. != "apiVersion" and . != "kind" and . != "resources" and . != "components")' "$k")
  [[ -z $extra ]] || err "$k: joins may only contain apiVersion/kind/resources/components, found: $(echo $extra)"
  [[ $(yq -o=json -I=0 '.resources' "$k") == '["../../base"]' ]] \
    || err "$k: resources must be exactly ../../base"
  [[ $(yq -r '.components[0] // ""' "$k") == "../../../../clusters/$c/facts" ]] \
    || err "$k: first component must be ../../../../clusters/$c/facts"
  bad=$(yq -r '.components[1:] | .[] | select(test("^\.\./\.\./facets/[^/]+(/[^/]+)?$") | not)' "$k")
  [[ -z $bad ]] || err "$k: components after the facts must be ../../facets/<facet>, found: $(echo $bad)"
done

# Cluster dirs.
declare -A canonical=() has_appset=() facet_names=()
is_git=false
git rev-parse --git-dir >/dev/null 2>&1 && is_git=true
mapfile -t appsets < <(appset_names)
# argocd/kustomization.yaml may differ only in which bootstrap/bases/<base> it uses.
normalize() { sed -E 's|bootstrap/bases/[^/[:space:]]+|bootstrap/bases/BASE|' "$1"; }
for c in "${clusters[@]}"; do
  d=clusters/$c
  for f in facts/kustomization.yaml facts/facts.yaml argocd/kustomization.yaml argocd/revisions.env; do
    [[ -f $d/$f ]] || err "$d: missing $f"
  done
  [[ ! -e $d/apps.yaml ]] || err "$d/apps.yaml: no longer used; apps are selected by their facets (apps/<app>/facets/)"
  if [[ -f $d/facts/facts.yaml ]]; then
    [[ $(yq -r '.data.name // ""' "$d/facts/facts.yaml") == "$c" ]] || err "$d/facts/facts.yaml: data.name must be '$c'"
    # The facet keys pick each app's facets; role also picks the ApplicationSet base.
    declare -A fact=()
    for k in "${FACET_KEYS[@]}"; do
      fact[$k]=$(K=$k yq -r '.data[strenv(K)] // ""' "$d/facts/facts.yaml")
      if [[ -z ${fact[$k]} ]]; then
        err "$d/facts/facts.yaml: data.$k is not set"
      elif [[ $k == environment && ! ${fact[$k]} =~ ^[a-z0-9]+$ ]]; then
        err "$d/facts/facts.yaml: data.environment must be lowercase letters and digits (it's the facet suffix)"
      elif [[ ! ${fact[$k]} =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
        err "$d/facts/facts.yaml: data.$k must be lowercase letters, digits and '-'"
      fi
    done
    role=${fact[role]} envname=${fact[environment]}
    if [[ -n $role ]]; then
      [[ -d bootstrap/bases/$role ]] || err "$d/facts/facts.yaml: role '$role' has no bootstrap/bases/$role/"
      [[ ! -f $d/argocd/kustomization.yaml ]] || grep -qxF -- "- ../../../bootstrap/bases/$role" "$d/argocd/kustomization.yaml" \
        || err "$d/argocd/kustomization.yaml: base must be ../../../bootstrap/bases/$role (its role)"
    fi
    if [[ -n $role && -n $envname ]] && [[ ! $c =~ ^$envname-$role-[a-z0-9]+-[0-9]+$ ]]; then
      err "$d: cluster name must be <environment>-<role>-<region>-<id>, e.g. $envname-$role-east-1"
    fi
    [[ $(yq -r '.metadata.annotations["config.kubernetes.io/local-config"] // ""' "$d/facts/facts.yaml") == "true" ]] \
      || err "$d/facts/facts.yaml: missing annotation config.kubernetes.io/local-config: \"true\""
    if [[ -n $envname ]]; then
      facet_names[environment/$envname]=1
      for k in "${FACET_KEYS[@]:1}"; do
        [[ -n ${fact[$k]} ]] && facet_names[$k/${fact[$k]}]=1 facet_names[$k/${fact[$k]}-$envname]=1
      done
    fi
    unset fact
  fi
  # facts/ and argocd/ kustomizations must be identical across clusters (argocd/ up to its base).
  for f in facts/kustomization.yaml argocd/kustomization.yaml; do
    [[ -f $d/$f ]] || continue
    if [[ -z ${canonical[$f]:-} ]]; then
      canonical[$f]=$d/$f
    elif ! cmp -s <(normalize "${canonical[$f]}") <(normalize "$d/$f"); then
      err "$d/$f: differs from ${canonical[$f]} (must be identical for every cluster, apart from the base)"
    fi
  done
  # The rendered ApplicationSets must build with every placeholder filled.
  cluster_sets=()
  if [[ -f $d/argocd/kustomization.yaml ]]; then
    if ! out=$(kustomize build "$d/argocd" 2>&1); then
      err "$d/argocd: kustomize build failed: $(echo "$out" | head -n1)"
    else
      grep -qE '\b(REVISION|CLUSTER)\b' <<<"$out" \
        && err "$d/argocd: rendered ApplicationSets still contain REVISION/CLUSTER placeholders"
      mapfile -t cluster_sets < <(yq -r 'select(.kind == "ApplicationSet") | .metadata.name' <<<"$out")
      for a in "${cluster_sets[@]}"; do has_appset[$c/$a]=1; done
    fi
  fi
  # Pins: ApplicationSets in this cluster's base, a full SHA or main, and (for cluster-config)
  # a commit with this cluster's joins.
  env=$d/argocd/revisions.env
  if [[ -f $env ]]; then
    dups=$(env_keys "$env" | sort | uniq -d)
    [[ -z $dups ]] || err "$env: duplicate keys: $(echo $dups)"
    while IFS= read -r key; do
      val=$(env_get "$env" "$key")
      if ! printf '%s\n' "${appsets[@]}" | grep -qxF "$key"; then
        err "$env: unknown ApplicationSet '$key' (not in bootstrap/appset-revisions/revisions.env)"
        continue
      fi
      [[ ${#cluster_sets[@]} -eq 0 || -n ${has_appset[$c/$key]:-} ]] \
        || err "$env: pins '$key' but this cluster's base doesn't include it"
      if [[ $val == main ]]; then
        continue
      elif [[ ! $val =~ ^[0-9a-f]{40}$ ]]; then
        err "$env: $key must be a full 40-character commit SHA or main, got '$val'"
      elif $is_git; then
        if ! git cat-file -e "$val^{commit}" 2>/dev/null; then
          err "$env: $key: commit $val not found (fetch it, or pin a commit on main)"
        elif [[ $key == cluster-config ]] && ! commit_has_cluster "$val" "$c"; then
          err "$env: $key: commit $val has no apps/*/clusters/$c/"
        fi
      fi
    done < <(env_keys "$env")
  fi
done

# Tenants: tenants/<tenant>/clusters/<cluster>/ needs a kustomization and a matching argocd.json.
for j in tenants/*/clusters/*/argocd.json; do
  [[ -f $j ]] || continue
  dir=$(dirname "$j")
  c=$(basename "$dir")
  t=$(basename "$(dirname "$(dirname "$dir")")")
  [[ -f $dir/kustomization.yaml ]] || err "$dir: missing kustomization.yaml"
  if [[ ! -d clusters/$c ]]; then
    err "$dir: no cluster named '$c'"
    continue
  fi
  [[ -n ${has_appset[$c/tenant-config]:-} ]] \
    || warnings+=("$dir: $c's base doesn't include tenant-config, so this isn't deployed")
  [[ $(yq -p=json -o=yaml -r '.tenant // ""' "$j") == "$t" ]] || err "$j: tenant must be '$t'"
  [[ $(yq -p=json -o=yaml -r '.cluster // ""' "$j") == "$c" ]] || err "$j: cluster must be '$c'"
  yq -p=json -e '[(.sync.wave | tag) == "!!str",
                  ((.sync.automated // {}) | to_entries | all_c(.value | tag == "!!bool"))] | all' "$j" >/dev/null 2>&1 \
    || err "$j: needs sync.wave as a string; sync.automated values must be booleans"
done

# App dirs.
for d in apps/*/; do
  d=${d%/}
  app=$(basename "$d")
  [[ -f $d/argocd.yaml ]] || err "$d: missing argocd.yaml"
  [[ -d $d/base ]] || err "$d: missing base/"
  for e in "$d"/* "$d"/.[!.]*; do
    [[ -e $e ]] || continue
    case $(basename "$e") in
      argocd.yaml|base|components|facets|clusters) ;;
      *) err "$e: not allowed; an app has only argocd.yaml, base/, components/, facets/ and clusters/" ;;
    esac
  done
  # Every Component dir under facets/: <key>/<value>, cluster/<cluster>, or per-cluster.
  facet_dirs=()
  for e in "$d"/facets/*/; do
    [[ -d $e ]] || continue
    e=${e%/}
    name=$(basename "$e")
    if [[ $name == "$CLUSTER_FACET" ]]; then
      for v in "$e"/*/; do
        [[ -d $v ]] || continue
        v=${v%/}
        facet_dirs+=("$v")
        if [[ -d clusters/$(basename "$v") ]]; then
          warnings+=("$v: cluster facet (one-off exception)")
        else
          warnings+=("$v: matches no cluster (no cluster named $(basename "$v"))")
        fi
      done
    elif printf '%s\n' "${FACET_KEYS[@]}" | grep -qxF "$name"; then
      for v in "$e"/*/; do
        [[ -d $v ]] || continue
        v=${v%/}
        facet_dirs+=("$v")
        [[ -n ${facet_names[$name/$(basename "$v")]:-} ]] \
          || warnings+=("$v: matches no cluster (no cluster has $name: $(basename "$v")$([[ $name == environment ]] || echo ", with or without an -<environment> suffix"))")
      done
    else
      facet_dirs+=("$e")
      [[ $name == "$PER_CLUSTER_FACET" ]] \
        || warnings+=("$e: matches no cluster (facets/ holds ${FACET_KEYS[*]}, $CLUSTER_FACET and $PER_CLUSTER_FACET)")
    fi
  done
  for f in "${facet_dirs[@]+"${facet_dirs[@]}"}"; do
    [[ $(yq -r '.kind // ""' "$f/kustomization.yaml" 2>/dev/null) == Component ]] \
      || err "$f: needs a kustomization.yaml with kind: Component"
    [[ ! -e $f/argocd.yaml ]] || err "$f/argocd.yaml: Argo CD settings are only set in $d/argocd.yaml"
  done
  # Components: modular pieces that facets use; never in a join directly.
  declare -A used=()
  for f in "${facet_dirs[@]+"${facet_dirs[@]}"}" "$d"/components/*/; do
    f=${f%/}
    [[ -f $f/kustomization.yaml ]] || continue
    while IFS= read -r ref; do
      [[ -n $ref ]] && used[$(realpath -m "$f/$ref")]=1
    done < <(yq -r '.components // [] | .[]' "$f/kustomization.yaml" 2>/dev/null)
  done
  for comp in "$d"/components/*/; do
    [[ -d $comp ]] || continue
    comp=${comp%/}
    [[ $(yq -r '.kind // ""' "$comp/kustomization.yaml" 2>/dev/null) == Component ]] \
      || err "$comp: needs a kustomization.yaml with kind: Component"
    [[ -n ${used[$(realpath -m "$comp")]:-} ]] || warnings+=("$comp: not used by any facet")
  done
  unset used
done

for w in "${warnings[@]+"${warnings[@]}"}"; do warn "$w"; done
if [[ ${#errors[@]} -gt 0 ]]; then
  printf 'lint: %s\n' "${errors[@]}" >&2
  die "${#errors[@]} lint violation(s)"
fi
echo "lint ok"
