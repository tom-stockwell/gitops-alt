#!/usr/bin/env bash
# Render every join into <outdir>/<cluster>/<app>.yaml.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/render-all <outdir> [repo-dir]

Renders every apps/<app>/clusters/<cluster>/ in repo-dir (default: this repo) to
<outdir>/<cluster>/<app>.yaml and copies its argocd.json to
<outdir>/<cluster>/<app>.argocd.json. Tenants (tenants/<tenant>/clusters/<cluster>/) go to
<outdir>/<cluster>/tenant-<tenant>.yaml and .argocd.json.
USAGE
}

case ${1:-} in -h|--help) usage; exit 0 ;; esac
[[ $# -ge 1 && $# -le 2 ]] || { usage >&2; exit 1; }

require_tools kustomize
mkdir -p "$1"
out=$(cd "$1" && pwd)
src=${2:-$(repo_root)}
[[ -d $src/apps ]] || die "$src has no apps/ directory"

for join in "$src"/apps/*/clusters/*/; do
  [[ -f $join/kustomization.yaml ]] || continue
  join=${join%/}
  cluster=$(basename "$join")
  app=$(basename "$(dirname "$(dirname "$join")")")
  mkdir -p "$out/$cluster"
  # shellcheck disable=SC2086
  kustomize build ${KUSTOMIZE_BUILD_OPTIONS:-} "$join" >"$out/$cluster/$app.yaml" \
    || die "kustomize build failed for apps/$app/clusters/$cluster"
  if [[ -f $join/argocd.json ]]; then
    cp "$join/argocd.json" "$out/$cluster/$app.argocd.json"
  fi
done

for dir in "$src"/tenants/*/clusters/*/; do
  [[ -f $dir/argocd.json && -f $dir/kustomization.yaml ]] || continue
  dir=${dir%/}
  cluster=$(basename "$dir")
  tenant=$(basename "$(dirname "$(dirname "$dir")")")
  mkdir -p "$out/$cluster"
  # shellcheck disable=SC2086
  kustomize build ${KUSTOMIZE_BUILD_OPTIONS:-} "$dir" >"$out/$cluster/tenant-$tenant.yaml" \
    || die "kustomize build failed for tenants/$tenant/clusters/$cluster"
  cp "$dir/argocd.json" "$out/$cluster/tenant-$tenant.argocd.json"
done
