#!/usr/bin/env bash
# Render what Argo CD applies for one or more cluster overlays.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/render [-o <outdir>] <overlay-dir>...

Runs kustomize build on each cluster overlay (e.g. apps/<app>/clusters/<cluster>) and prints
the results to stdout, separated by '---'. With -o, writes each to
<outdir>/<cluster>/<app>.yaml (for apps/<app>/clusters/<cluster>) instead. Only manifests are rendered, not Argo CD settings. Extra kustomize flags can be passed
in \$KUSTOMIZE_BUILD_OPTIONS.
USAGE
}

out=""
dirs=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    -o) [[ $# -ge 2 ]] || die "-o needs a value"; out=$2; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) dirs+=("${1%/}"); shift ;;
  esac
done
[[ ${#dirs[@]} -gt 0 ]] || { usage >&2; exit 1; }

require_tools kustomize
first=true
for dir in "${dirs[@]}"; do
  [[ -f $dir/kustomization.yaml ]] || die "no such overlay: $dir"
  if [[ -z $out ]]; then
    $first || echo "---"
    first=false
    # shellcheck disable=SC2086
    kustomize build ${KUSTOMIZE_BUILD_OPTIONS:-} "$dir" || die "kustomize build failed for $dir"
    continue
  fi
  [[ $dir =~ (^|/)apps/([^/]+)/clusters/([^/]+)$ ]] \
    || die "can't name output for $dir (expected …/apps/<app>/clusters/<cluster>)"
  name=${BASH_REMATCH[2]} cluster=${BASH_REMATCH[3]}
  mkdir -p "$out/$cluster"
  # shellcheck disable=SC2086
  kustomize build ${KUSTOMIZE_BUILD_OPTIONS:-} "$dir" >"$out/$cluster/$name.yaml" || die "kustomize build failed for $dir"
done
