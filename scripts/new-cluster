#!/usr/bin/env bash
# Scaffold a new cluster from an existing one.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/new-cluster <name> --from <existing> [--domain <domain>]
                           [--type <clusterType>] [--environment <environment>]

<name> must be <environment>-<clusterType>-<region>-<id>, e.g. prod-workload-east-3.

Copies clusters/<existing> to clusters/<name> and sets its facts: name, and domain,
clusterType and environment if given (otherwise kept from <existing>). Points its
ApplicationSets at bootstrap/bases/<clusterType>, resets apps.yaml to no exceptions and
revisions.env to no pins (tracks main), generates its joins and shows what will run there.
USAGE
}

name="" from="" domain="" ctype="" envname=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --from) [[ $# -ge 2 ]] || die "--from needs a value"; from=$2; shift 2 ;;
    --domain) [[ $# -ge 2 ]] || die "--domain needs a value"; domain=$2; shift 2 ;;
    --type) [[ $# -ge 2 ]] || die "--type needs a value"; ctype=$2; shift 2 ;;
    --environment) [[ $# -ge 2 ]] || die "--environment needs a value"; envname=$2; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z $name ]] || die "unexpected argument: $1"; name=$1; shift ;;
  esac
done
[[ -n $name && -n $from ]] || { usage >&2; exit 1; }

require_tools yq
ROOT=$(repo_root)
[[ ${#name} -le 63 && $name =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || die "'$name' is not a valid DNS-1123 label"
[[ ! -e $ROOT/clusters/$name ]] || die "clusters/$name already exists"
[[ -d $ROOT/clusters/$from ]] || die "unknown cluster: $from"

[[ -n $ctype ]] || ctype=$(cluster_fact "$from" clusterType)
[[ -n $envname ]] || envname=$(cluster_fact "$from" environment)
[[ -f $ROOT/profiles/cluster-type/$ctype.yaml && -d $ROOT/bootstrap/bases/$ctype ]] \
  || die "unknown clusterType '$ctype' (needs profiles/cluster-type/$ctype.yaml and bootstrap/bases/$ctype/)"
[[ -f $ROOT/profiles/environment/$envname.yaml ]] \
  || die "unknown environment '$envname' (needs profiles/environment/$envname.yaml)"
[[ $name =~ ^$envname-$ctype-[a-z0-9]+-[0-9]+$ ]] \
  || die "'$name' must be <environment>-<clusterType>-<region>-<id>, e.g. $envname-$ctype-east-1"

cp -R "$ROOT/clusters/$from" "$ROOT/clusters/$name"
facts=$ROOT/clusters/$name/facts/facts.yaml
NAME=$name CTYPE=$ctype ENVNAME=$envname yq -i \
  '.data.name = strenv(NAME) | .data.clusterType = strenv(CTYPE) | .data.environment = strenv(ENVNAME)' "$facts"
if [[ -n $domain ]]; then
  DOMAIN=$domain yq -i '.data.domain = strenv(DOMAIN)' "$facts"
fi
# yq -i collapses comment spacing; keep the source's.
sed -i 's|"true" # used by replacements|"true"   # used by replacements|' "$facts"
sed -i 's|^\(- \.\./\.\./\.\./bootstrap/bases/\)[^/[:space:]]*$|\1'"$ctype"'|' "$ROOT/clusters/$name/argocd/kustomization.yaml"
# Pins don't carry over: the source's pinned commits don't contain this cluster yet.
grep -E '^[[:space:]]*(#|$)' "$ROOT/clusters/$from/argocd/revisions.env" >"$ROOT/clusters/$name/argocd/revisions.env" || true
cat >"$ROOT/clusters/$name/apps.yaml" <<EOF
# Exceptions for this cluster; its clusterType and environment profiles set the rest.
apps: {}
EOF

"$SCRIPT_DIR/generate" "$name"
echo
"$SCRIPT_DIR/whatruns" "$name"
