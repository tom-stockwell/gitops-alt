#!/usr/bin/env bash
# Scaffold a new cluster from an existing one.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<USAGE
Usage: scripts/new-cluster <name> --from <existing> [--domain <domain>]

Copies clusters/<existing> to clusters/<name>, sets the facts name (and domain),
resets apps.yaml to extend the same profile with no overrides and its revisions.env
to no pins (tracks main), generates its joins and shows what will run there.
USAGE
}

name="" from="" domain=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --from) [[ $# -ge 2 ]] || die "--from needs a value"; from=$2; shift 2 ;;
    --domain) [[ $# -ge 2 ]] || die "--domain needs a value"; domain=$2; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z $name ]] || die "unexpected argument: $1"; name=$1; shift ;;
  esac
done
[[ -n $name && -n $from ]] || { usage >&2; exit 1; }

require_tools yq
ROOT=$(repo_root)
[[ ${#name} -le 63 && $name =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || die "'$name' is not a valid DNS-1123 label"
[[ ! -e $ROOT/clusters/$name ]] || die "clusters/$name already exists"
[[ -d $ROOT/clusters/$from ]] || die "unknown cluster: $from"

profile=$(yq '.extends // ""' "$ROOT/clusters/$from/apps.yaml")
cp -R "$ROOT/clusters/$from" "$ROOT/clusters/$name"
NAME=$name yq -i '.data.name = strenv(NAME)' "$ROOT/clusters/$name/facts/facts.yaml"
if [[ -n $domain ]]; then
  DOMAIN=$domain yq -i '.data.domain = strenv(DOMAIN)' "$ROOT/clusters/$name/facts/facts.yaml"
fi
# Pins don't carry over: the source's pinned commits don't contain this cluster yet.
grep -E '^[[:space:]]*(#|$)' "$ROOT/clusters/$from/argocd/revisions.env" >"$ROOT/clusters/$name/argocd/revisions.env" || true
if [[ -n $profile ]]; then
  echo "extends: $profile" >"$ROOT/clusters/$name/apps.yaml"
else
  echo "apps: {}" >"$ROOT/clusters/$name/apps.yaml"
fi

"$SCRIPT_DIR/generate" "$name"
echo
"$SCRIPT_DIR/whatruns" "$name"
